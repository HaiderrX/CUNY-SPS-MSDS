## Data Preparation

```{r setup, echo=TRUE, results='hide', warning=FALSE, message=FALSE}
# load data

# Installing the data source (uncomment if you need to install, but will provide a read_csv at the end)
# devtools::install_github("jfjelstul/worldcup")
library(worldcup)
library(tidyverse)
data(package = "worldcup")$results[, "Item"]

# Filtering for mens
cases <- team_appearances |>
  filter(str_detect(tournament_name, "Men's"),
         match_date >= as.Date("1970-01-01"))

# Card counts
card_counts <- bookings |>
  group_by(match_id, team_id) |>
  summarise(cards = n(),
            sent_off = sum(sending_off),
            .groups = "drop")

# Building our cases
cases <- cases |>
  left_join(card_counts, by = c("match_id", "team_id")) |>
  mutate(across(c(cards, sent_off), ~ replace_na(.x, 0)))

# Host Countries
host_list <- host_countries |>
  select(tournament_id, team_id) |>
  mutate(host = 1)

cases <- cases |>
  left_join(host_list, by = c("tournament_id", "team_id"))

cases <- cases |>
  mutate(host = replace_na(host, 0))

# Referees filter and matching
ref_list <- referee_appearances |>
  select(match_id, referee_id, ref_confed = confederation_code)

cases <- cases |>
  left_join(ref_list, by = "match_id")

# Team filter and matching 
team_list <- teams |>
  select(team_id, team_confed = confederation_code)

cases <- cases |>
  left_join(team_list, by = "team_id")

cases <- cases |>
  mutate(same_confed = as.integer(team_confed == ref_confed))

# Years List and filter (start when cards were implemented)
cases <- cases |>
  mutate(year = as.integer(str_sub(tournament_id, 4, 7)))

cases <- cases |>
  mutate(era = cut(year,
                   breaks = c(1969, 1979, 1995, 2011, 2022),
                   labels = c("1970s", "1982-94", "1998-2010", "2014-22")))

# We want at least 1 card and at least 1 send off
cases <- cases |>
  mutate(any_card    = as.integer(cards > 0),
         any_sent_off = as.integer(sent_off > 0))

# Final Table
final_table <- cases |>
  select(tournament_id, tournament_name, year, era, match_id, match_date,
         stage_name, group_stage, knockout_stage,
         team_id, team_name, team_confed, opponent_name,
         goals_for, goals_against, goal_differential, result,
         host, ref_confed, same_confed,
         cards, any_card, sent_off, any_sent_off)

nrow(final_table)
```

